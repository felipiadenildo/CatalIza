---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="mx-auto max-w-2xl px-5 py-16">
  <span class="text-xs font-bold uppercase tracking-widest" style="color: var(--primary);">{t("contact.eyebrow")}</span>
  <h1 class="text-2xl font-extrabold mt-1">{t("contact.title")}</h1>
  <p class="mt-3 text-sm leading-relaxed" style="color: var(--text-muted);">{t("contact.body")}</p>
  <div class="rounded-xl border p-5 mt-6" style="border-color: var(--border); background: var(--surface-2);">
    <p class="text-sm" style="color: var(--text-faint);">{t("contact.emailPending")}</p>
  </div>
</div>
